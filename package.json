{
  "name": "tiendanube-account-manager",
  "version": "1.3.0",
  "description": "Gestión local de cuentas autorizadas de Tiendanube",
  "author": "Tiendanube Manager",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:ui": "node scripts/smoke.js",
    "browser:install": "node scripts/install-browser.js",
    "dist": "npm run browser:install && electron-builder --win nsis --x64",
    "pack": "electron-builder --win --dir --x64"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "proxy-chain": "3.0.1"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.tiendanubemanager.desktop",
    "productName": "Tiendanube Account Manager",
    "executableName": "TiendanubeManager",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "browsers",
        "to": "browsers",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "README.md",
        "to": "README.md"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "TiendanubeManager.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
